# Copy this file to `.env` and fill in your real keys.
# `.env` is gitignored — never commit real keys.
#
# After creating/updating `.env`, sync native iOS config:
#   bash scripts/sync_env_to_native.sh
#
# Restrict keys in Google Cloud Console (Android package + SHA-1, iOS bundle ID).

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
